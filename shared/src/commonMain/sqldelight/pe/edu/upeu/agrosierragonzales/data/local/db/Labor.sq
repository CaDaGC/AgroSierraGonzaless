CREATE TABLE labor(
 id INTEGER NOT NULL PRIMARY KEY,loteId INTEGER NOT NULL,tipo TEXT NOT NULL,fecha TEXT NOT NULL,
 responsable TEXT NOT NULL,cantidad REAL NOT NULL,observacion TEXT NOT NULL,
 pendiente INTEGER NOT NULL DEFAULT 0,operacion TEXT NOT NULL DEFAULT 'CREATE'
);
selectByLote: SELECT * FROM labor WHERE loteId=? AND operacion!='DELETE' ORDER BY fecha DESC,id DESC;
selectPending: SELECT * FROM labor WHERE pendiente=1 ORDER BY fecha ASC,id ASC;
insertLabor: INSERT OR REPLACE INTO labor VALUES(?,?,?,?,?,?,?,?,?);
nextTemporaryId: SELECT COALESCE(MIN(id),0)-1 FROM labor WHERE id<0;
deleteLocal: DELETE FROM labor WHERE id=?;
deleteById: DELETE FROM labor WHERE id=?;
